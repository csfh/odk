#!/usr/bin/env bash
# Measures what a program costs while it sits idle, on its real renderer, under the same private
# headless sway as tools/headless-shot (CLAUDE.md, "Windows: headless only"): the CPU it uses,
# once it has settled.
#
#   tools/idle-cpu [--max PERCENT] [--settle SECONDS] [--window SECONDS] COMMAND...
#
# --max makes it exit 1 when the CPU is over PERCENT. COMMAND is a program built in release mode,
# for example a story: cargo build --release -p stories --bin button, then
# tools/idle-cpu target/release/button. It is the number to hold a program to: the benchmarks
# (cargo bench) draw on a stand-in for text, this does not.
#
# The numbers to hold a program to: at most 2% while idle and at most 8% with a spinner in view.
#
# Prints one line, for example:  button: 0.2% cpu (0.01 s in 5 s)
# A window that draws nothing while idle prints about 0%: the sway and the logging that counts it
# cost about 1%; a spinner redraws its window ten times a second, and the headless renderer paints
# the whole window in software each time. (Surface commits are not frames: GPUI commits on every
# frame callback of the compositor whether or not it drew, so they are not counted.)
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)

if [[ ${1:-} == --measure ]]; then
    # Runs inside headless-shot: start the program, let it settle, count over a window.
    shift
    settle=$1 window=$2 label=$3 max=$4
    shift 4
    "$@" >/dev/null 2>&1 &
    pid=$!
    sleep "$settle"
    ticks=$(getconf CLK_TCK)
    cpu() { awk -v t="$ticks" '{print ($14 + $15) / t}' "/proc/$pid/stat"; }
    a=$(cpu)
    sleep "$window"
    b=$(cpu)
    kill "$pid" 2>/dev/null || true
    awk -v a="$a" -v b="$b" -v w="$window" -v n="$label" -v max="$max" 'BEGIN {
        pct = (b - a) / w * 100
        printf "%s: %.1f%% cpu (%.2f s in %d s)", n, pct, b - a, w
        if (max != "" && pct > max) { printf "  OVER %s%%\n", max; exit 1 }
        printf "\n"
    }'
    exit 0
fi

max=""
settle=4
window=5
while [[ $# -gt 0 ]]; do
    case $1 in
        --max) max=$2; shift 2 ;;
        --settle) settle=$2; shift 2 ;;
        --window) window=$2; shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
[[ $# -gt 0 ]] || { echo "usage: tools/idle-cpu [--max PERCENT] [--settle SECONDS] [--window SECONDS] COMMAND..." >&2; exit 2; }
[[ -x $1 ]] || { echo "$1 is not built (cargo build --release -p stories --bin NAME)" >&2; exit 1; }

shot=$(mktemp -u /tmp/odk-idle.XXXXXX.png)
# headless-shot waits `--wait` seconds before its screenshot, which must outlast the measurement.
out=$("$here/headless-shot" --wait $((settle + window + 4)) "$shot" -- \
    "$0" --measure "$settle" "$window" "$(basename "$1")" "$max" "$@" 2>&1 |
    grep -v "^the program exited early" | grep -v "^$shot$" || true)
rm -f "$shot"
echo "$out"
# The measurement runs inside the headless session, whose exit status does not come back; its
# verdict is in what it printed.
[[ $out == *OVER* ]] && exit 1
[[ $out == *cpu* ]] || { echo "no measurement was made" >&2; exit 1; }
exit 0
