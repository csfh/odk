#!/usr/bin/env python3
"""Checks that building any one workspace member reuses exactly the artifacts of a workspace
build, so switching between `cargo -p` selections never recompiles GPUI.

It compares what Cargo actually builds (`cargo build --message-format=json`), because
`cargo tree` cannot show everything that changes an artifact: a crate used only by build
scripts in one selection but at run time in another is built with a different profile. When
everything agrees all builds are fresh and this takes seconds; when not, it compiles the
differing configuration once and names the crates at the bottom of the difference. Add those to
crates/deps/Cargo.toml as normal dependencies with the features the workspace uses.
Extra arguments go to `cargo build`, for example `--release`. Exits 1 if anything differs."""

import json
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def members():  # noqa: D103
    paths = tomllib.loads((ROOT / "Cargo.toml").read_text())["workspace"]["members"]
    names = [tomllib.loads((ROOT / p / "Cargo.toml").read_text())["package"]["name"] for p in paths]
    return [n for n in names if n != "deps"]


EXTRA = sys.argv[1:]  # for example --release


def artifacts(args):
    """Each built unit, keyed by package and target, mapped to (artifact file names, features)."""
    out = subprocess.run(
        ["cargo", "build", *args, *EXTRA, "--message-format=json"], capture_output=True, text=True, cwd=ROOT, check=True
    ).stdout
    units = {}
    for line in out.splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("reason") != "compiler-artifact":
            continue
        key = (message["package_id"], message["target"]["name"], tuple(message["target"]["kind"]))
        files = tuple(sorted(Path(f).name for f in message["filenames"]))
        units.setdefault(key, set()).add((files, tuple(sorted(message["features"]))))
    return units


def graph():
    """Local package ids, and each package id's dependencies (of every kind)."""
    meta = json.loads(subprocess.run(
        ["cargo", "metadata", "--format-version", "1"], capture_output=True, text=True, cwd=ROOT, check=True
    ).stdout)
    deps = {node["id"]: {d["pkg"] for d in node["deps"]} for node in meta["resolve"]["nodes"]}
    names = {p["id"]: f"{p['name']} {p['version']}" for p in meta["packages"]}
    return set(meta["workspace_members"]), deps, names


def main():
    local, deps, names = graph()
    whole = artifacts(["--workspace"])
    failed = False
    for name in members():
        alone = artifacts(["-p", name])
        differing = {k[0] for k in alone if k in whole and not alone[k] <= whole[k]}
        # The bottom of each difference: a dependency that differs although nothing it depends
        # on does. Everything above it, local packages included, only follows.
        causes = sorted(p for p in differing if p not in local and not (deps.get(p, set()) & differing))
        for package in causes:
            print(f"{name}: {names.get(package, package)} is built differently from the workspace build")
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
