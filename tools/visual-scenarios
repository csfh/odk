#!/usr/bin/env bash
# Takes the gallery's reference screenshots: the same pages, themes and settings every time, so
# that a change to how a component draws can be looked at beside the last. Every shot goes
# through tools/headless-shot, which runs the gallery under a private headless sway
# (CLAUDE.md, "Windows: headless only"); nothing here touches the user's session.
#
#   tools/visual-scenarios [--out DIR] [--only themes|geometry|states] [--binary PATH]
#
# themes   the pages that show every component family, in the six themes of Phase 12: Tokyo
#          Night, Nord, Catppuccin Mocha, Vantablack, Catppuccin Latte and the incomplete
#          custom theme (crates/odk-theme/tests/fixtures), at the default density and corners.
# geometry the buttons, fields and navigation pages at each density, with square and subtle
#          corners, in Tokyo Night.
# states   keyboard focus (ten Tabs) on the buttons and fields pages, reduced motion on the
#          motion page, and the File menu opened with the keyboard on the overlays page.
#
# The window is 1600x1000 and the fonts are the machine's, so shots compare on one machine and
# one fontconfig. They are for the eye, not for a pixel diff: text shaping and the software
# renderer differ between machines. Nothing here asserts; the assertions are in the tests
# (`cargo test --workspace`).
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$here")
out=$root/target/visual
only=all
binary=$root/target/debug/gallery
while [[ $# -gt 0 ]]; do
    case $1 in
        --out) out=$2; shift 2 ;;
        --only) only=$2; shift 2 ;;
        --binary) binary=$2; shift 2 ;;
        *) echo "unknown option $1" >&2; exit 2 ;;
    esac
done
[[ -x $binary ]] || { echo "build the gallery first: cargo build -p gallery" >&2; exit 1; }
mkdir -p "$out"
fixtures=$root/crates/odk-theme/tests/fixtures

shot() { # NAME KEYS ENV... -- the page and settings come from the environment
    local name=$1 keys=$2
    shift 2
    local args=(--size 1600x1000 --wait 4)
    [[ -n $keys ]] && args+=(--keys "$keys")
    env "$@" "$here/headless-shot" "${args[@]}" "$out/$name.png" -- "$binary"
}

if [[ $only == all || $only == themes ]]; then
    for theme in tokyo-night nord catppuccin vantablack catppuccin-latte custom-incomplete; do
        for page in buttons form feedback overlays; do
            shot "theme-$theme-$page" "" GALLERY_PAGE=$page GALLERY_THEME=$fixtures/$theme
        done
    done
fi

if [[ $only == all || $only == geometry ]]; then
    for density in compact default comfortable; do
        for corners in square subtle; do
            for page in buttons fields navigation; do
                shot "geometry-$density-$corners-$page" "" GALLERY_PAGE=$page \
                    GALLERY_THEME=$fixtures/tokyo-night GALLERY_DENSITY=$density GALLERY_CORNERS=$corners
            done
        done
    done
fi

if [[ $only == all || $only == states ]]; then
    # Ten Tabs: the toolbar's theme, system theme, density, corners, motion, content and reset,
    # the sidebar's search and its list, then the page's first control.
    tabs="Tab Tab Tab Tab Tab Tab Tab Tab Tab Tab"
    for page in buttons fields; do
        shot "state-focus-$page" "$tabs" GALLERY_PAGE=$page GALLERY_THEME=$fixtures/tokyo-night
    done
    shot "state-reduced-motion-motion" "" GALLERY_PAGE=motion GALLERY_THEME=$fixtures/tokyo-night GALLERY_MOTION=reduced
    shot "state-menu-open-overlays" "$tabs Return" GALLERY_PAGE=overlays GALLERY_THEME=$fixtures/nord
fi
