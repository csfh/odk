#!/usr/bin/env bash
# Assembles the release tarball from built programs, and the `install.sh` that names it (ADR 0063,
# ADR 0086).
#
#   tools/package-release BIN_DIR OUT_DIR VERSION
#
# BIN_DIR holds the built `odk`, `odk-oma`, `oma-consent` and `odkd`, and THIRD-PARTY-LICENSES,
# their licences as `tools/third-party-licenses Cargo.toml BIN_DIR/THIRD-PARTY-LICENSES odk-cli
# oma oma-consent odkd` writes them (ADR 0081); this script runs no cargo. OUT_DIR gets
# `odk-x86_64-linux.tar.gz` and a copy of `install.sh` with the release's version and the
# tarball's length and SHA-256 written into it, which `odk oma sign-release OUT_DIR` then signs.
# The release's version is the Unix seconds now, or SOURCE_DATE_EPOCH when it is set; VERSION is
# the name `odk/VERSION` carries.
# The layout inside the tarball is the one `install.sh` installs:
#
#   odk/VERSION   odk/bin/odk   odk/lib/odk/{odk-oma,oma-consent,odkd}
#   odk/share/systemd/user/{odkd.socket,odkd-files.socket,odkd.service,
#       oma-register.service,oma-applications.path,oma-inbox@.path}
#   odk/share/mime/packages/oma.xml
#   odk/share/doc/odk/{LICENSE,THIRD-PARTY-LICENSES}
#
# A release and the installer's test both call this, so the asset names and the layout cannot
# drift.
set -euo pipefail

[[ $# -eq 3 ]] || { sed -n 3,4p "$0" >&2; exit 2; }
bin=$1 out=$2 version=$3
root=$(cd "$(dirname "$0")/.." && pwd)
name=odk-x86_64-linux

for program in odk odk-oma oma-consent odkd; do
    [[ -x $bin/$program ]] || { echo "package-release: no $bin/$program" >&2; exit 1; }
done
[[ -f $bin/THIRD-PARTY-LICENSES ]] || {
    echo "package-release: no $bin/THIRD-PARTY-LICENSES (tools/third-party-licenses)" >&2
    exit 1
}
[[ $version =~ ^[A-Za-z0-9._-]+$ ]] || { echo "package-release: bad version '$version'" >&2; exit 2; }

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
mkdir -p "$stage/odk/bin" "$stage/odk/lib/odk" "$stage/odk/share/systemd/user" \
    "$stage/odk/share/mime/packages" "$stage/odk/share/doc/odk" "$out"
install -m 755 "$bin/odk" "$stage/odk/bin/odk"
for program in odk-oma oma-consent odkd; do
    install -m 755 "$bin/$program" "$stage/odk/lib/odk/$program"
done
install -m 644 "$root/packaging/systemd/user/odkd.socket" \
    "$root/packaging/systemd/user/odkd-files.socket" "$root/packaging/systemd/user/odkd.service" \
    "$root/packaging/systemd/user/oma-register.service" \
    "$root/packaging/systemd/user/oma-applications.path" \
    "$root/packaging/systemd/user/oma-inbox@.path" \
    "$stage/odk/share/systemd/user/"
install -m 644 "$root/packaging/mime/oma.xml" "$stage/odk/share/mime/packages/oma.xml"
install -m 644 "$root/LICENSE" "$bin/THIRD-PARTY-LICENSES" "$stage/odk/share/doc/odk/"
printf '%s\n' "$version" >"$stage/odk/VERSION"

# The same bytes for the same inputs: sorted, no owner, no times, no gzip name or time.
tar --sort=name --owner=0 --group=0 --numeric-owner --mtime=@0 -C "$stage" -cf - odk \
    | gzip -n -9 >"$out/$name.tar.gz"

# The script names the tarball, so the release root's signature over the script covers it.
release_version=${SOURCE_DATE_EPOCH:-$(date +%s)}
[[ $release_version =~ ^[0-9]+$ ]] || { echo "package-release: bad SOURCE_DATE_EPOCH" >&2; exit 2; }
sha256=$(sha256sum "$out/$name.tar.gz" | cut -d' ' -f1)
length=$(stat -c %s "$out/$name.tar.gz")
for line in release_version tarball_sha256 tarball_length; do
    [[ $(grep -c "^$line=\$" "$root/install.sh") -eq 1 ]] \
        || { echo "package-release: install.sh has no empty '$line=' line" >&2; exit 1; }
done
sed -e "s/^release_version=\$/release_version=$release_version/" \
    -e "s/^tarball_sha256=\$/tarball_sha256=$sha256/" \
    -e "s/^tarball_length=\$/tarball_length=$length/" \
    "$root/install.sh" >"$out/install.sh"
chmod 755 "$out/install.sh"
rm -f "$out/$name.tar.gz.sha256" "$out/install.sh.sig" "$out/release" "$out/release.sig"
echo "$out/$name.tar.gz"
